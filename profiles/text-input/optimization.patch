+from types import SimpleNamespace
+from src.lsd.gl_gui.view.core_views.decoration import invalidation_decoration as decoration
+
+
+def test_private_cache_assignment_never_compares_contents(monkeypatch):
+    calls = []
+    cache = SimpleNamespace(invalidate_by_obj=lambda *a, **kw: calls.append(a[1]))
+    melty = SimpleNamespace(frame_count=5, silence_invalidate=False, cache=cache)
+    monkeypatch.setattr(decoration.Core, 'melty', melty)
+    from src.lsd.gl_gui.view.attribute_churn import AttributeChurnMonitor
+    monkeypatch.setattr(AttributeChurnMonitor, 'record', lambda *args: None)
+    from src.lsd.gl_gui.toggles import Toggles
+    monkeypatch.setattr(Toggles.InvalidateTracker, 'attrib_change_stack_trace', False)
+
+    @decoration.live
+    class State:
+        def __init__(self):
+            self.value = 0
+
+    compared = []
+    class Buffer:
+        def __ne__(self, other):
+            compared.append(other)
+            return True
+
+    state = State()
+    old, new = Buffer(), Buffer()
+    state._buffer = old
+    state._buffer = new
+    assert state._buffer is new
+    assert compared == []
+    assert calls == []
+    state.value = 1
+    assert calls == ['value']
+    state.value = 1
+    assert calls == ['value']
