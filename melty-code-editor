#!/bin/sh
# Launcher: run editor.py on the project's own venv (.venv beside this file),
# with meltygui and meltygui_pro installed editable — see README "Setup".
# No PYTHONPATH: the interpreter resolves both packages through the venv.
here=$(dirname "$(readlink -f "$0")")
python="$here/.venv/bin/python"
if [ ! -x "$python" ]; then
    echo "melty-code-editor: no .venv — run the Setup steps in README.md" >&2
    exit 1
fi
MELTY_T0=$(date +%s.%N) exec "$python" "$here/editor.py" "$@"
